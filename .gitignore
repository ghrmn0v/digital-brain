# Merged ignore rules for the three subsystems in this repository.
# Union of the Core Brain, Product and Fly rules; every original intent is kept.

# --- python (Core Brain, connectome) ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
data/

# --- node / next.js (Product, desktop, whatsapp-gateway) ---
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.next/
/out/
/.vercel
next-env.d.ts
*.tsbuildinfo

# --- java (fly backend) ---
target/
.gradle/

# --- build output ---
build/
dist/
out/

# --- test and coverage output ---
/coverage
.coverage
htmlcov/

# --- env and secrets ---
# Product's rule is the strictest of the three: it covers .env, .env.* and
# .env.local, and opts the template back in.
.env*
!.env.example
*.pem
*.key

# --- local databases ---
*.db
*.db-journal
*.db-shm
*.db-wal
/prisma/*.db*

# --- generated clients ---
/src/generated/prisma/

# --- fly: whatsapp credentials / session (never commit) ---
.wwebjs_auth/
.wwebjs_cf/

# --- fly: rl experiment artifacts, reproducible from code + data ---
connectome/connectome/training/rl/experiments/*.pt
connectome/connectome/training/rl/experiments/*.json
connectome/connectome/training/evaluation_reports/*.json
connectome/connectome/training/datasets/

# --- logs and debug ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- os / editor ---
.DS_Store
