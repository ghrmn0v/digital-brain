# Digital Brain — local configuration.
#
# Copy to `.env` and fill in what you need. This file lists every variable the
# system reads, grouped by the subsystem that owns it. A filled-in `.env` is
# gitignored and must never be committed.
#
# Nothing here is required. The Brain, the Product and Fly all start and work
# with this file absent; each subsystem falls back to a safe local default.

# ===========================================================================
# Product (Ayxan) — the local-first control plane
# ===========================================================================

# Local-first SQLite database. Relative paths resolve from the project root.
DATABASE_URL="file:./dev.db"

# Required for non-local service APIs in production. Use a long random value.
SERVICE_API_TOKEN="replace-with-a-long-random-token"

# Core Brain delivery adapter. The Brain isolates every event by user, so a
# local (single-user) Product must name the owner it delivers for. Without it
# the delivery fails loudly rather than attributing data to the wrong identity.
CORE_BRAIN_URL="http://127.0.0.1:8765/v1/brain"
CORE_BRAIN_USER_ID=""
CORE_BRAIN_API_TOKEN=""

# Fly/Connectome delivery adapter.
FLY_EVENTS_URL=""
FLY_API_TOKEN=""

# External request timeout in milliseconds.
INTEGRATION_REQUEST_TIMEOUT_MS="5000"

# Local worker target and polling interval.
APP_URL="http://localhost:3000"
WORKER_INTERVAL_MS="30000"

# ===========================================================================
# Core Brain (Hüseyn) — the intelligence layer
# ===========================================================================
# The Brain is fully functional with none of these set: it answers from stored
# memory using its deterministic heuristic provider. See docs/operating.md.

# Which LLM provider answers understanding/analysis requests.
#   heuristic - deterministic, offline, always available (default)
#   gemini    - calls Google Gemini, falls back to heuristic on any failure
# Equivalent to the transport's --provider flag, which wins over this value.
#BRAIN_LLM_PROVIDER=heuristic

# Structured records go to stderr. Off by default: a library must not write to
# a host's stderr uninvited. Records carry identifiers, counts and reasons —
# never memory content, and never a credential.
#BRAIN_LOG_ENABLED=1
#BRAIN_LOG_LEVEL=info          # debug | info | warning | error
#BRAIN_LOG_FORMAT=json         # json (one object per line) | text

# Gemini is an inference provider, not the Brain's memory. The Brain still owns
# memory, context, identity, preferences and learning; the model only ever sees
# bounded context the Brain chose to send it.
#
# GEMINI_ENABLED is a separate, explicit opt-in so a stray key cannot silently
# start sending data to a third party.
#GEMINI_ENABLED=1
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-3.8-flash
#GEMINI_API_BASE=https://generativelanguage.googleapis.com
#GEMINI_TIMEOUT_SECONDS=30
#GEMINI_TEMPERATURE=0.2
#GEMINI_MAX_OUTPUT_TOKENS=2048
